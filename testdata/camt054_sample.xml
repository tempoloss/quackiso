<?xml version="1.0" encoding="UTF-8"?>
<!-- camt.054 debit/credit notification. The per-account container is <Ntfctn>
     rather than <Stmt>, but the <Ntry> children are identical, so one reader
     serves camt.052/053/054. This sample locks that. -->
