<?xml version="1.0" encoding="UTF-8"?>
<!-- camt.037 as the 2005 first edition spelled it: the container is the
     versioned identifier itself, each party is a bare BIC with no Pty/Agt
     choice, and the underlying payment is stated inline (AssgneInstrId,
     CcyAmt, ValDt) rather than under Initn or IntrBk. The amount to debit -
     the point of the message - is only in this edition among the published
     samples.

     Shape from the Nivaes/Iso20022Net test resources (MIT),
     Iso20022.UnitTest/Resources/Camt/camt.037.001.01. -->
<Document xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance" xmlns = "urn:iso:std:iso:20022:tech:xsd:camt.037.001.01">
