		<Assgnmt>
			<Id>BNPRFDA20050419001</Id>
			<Assgnr>BNPAFRPP</Assgnr>
			<Assgne>CUSCFRPP</Assgne>
			<CreDtTm>2005-04-19T10:19:02</CreDtTm>
		</Assgnmt>
		<Case>
			<Id>CUSB200504001</Id>
			<Cretr>CUSBFRPP</Cretr>
		</Case>
		<Undrlyg>
			<AssgneInstrId>E20050418027</AssgneInstrId>
			<CcyAmt Ccy = "EUR">12347.56</CcyAmt>
