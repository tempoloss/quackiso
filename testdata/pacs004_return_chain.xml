<?xml version="1.0" encoding="UTF-8"?>
<!-- pacs.004 payment return whose party names exist ONLY in <RtrChain>, which
     describes the return, not the payment: its debtor is the party giving the
     money back, so it is the ORIGINAL CREDITOR.

