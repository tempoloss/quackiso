<?xml version="1.0" encoding="UTF-8"?>
<!-- A camt.053 for an account that had no movements in the period. Banks send
     these, and they are valid: <Stmt> with balances and no <Ntry> children.

     It is here to pin the shape of the message-identity check. Requiring an entry
     would reject this file; requiring only well-formed XML would accept a
     pacs.004 read as a statement. So the check is on the container — <Stmt>,
     <Ntfctn> or <Rpt> — and this file returns zero rows and no error. -->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.02">
  <BkToCstmrStmt>
    <GrpHdr>
      <MsgId>STMT-EMPTY-0001</MsgId>
      <CreDtTm>2026-07-31T23:59:00</CreDtTm>
    </GrpHdr>
    <Stmt>
      <Id>STMT-KZ-EMPTY</Id>
      <CreDtTm>2026-07-31T23:59:00</CreDtTm>
      <Acct>
        <Id><IBAN>KZ86125KZT5004100100</IBAN></Id>
        <Ccy>KZT</Ccy>
      </Acct>
      <Bal>
        <Tp><CdOrPrtry><Cd>OPBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="KZT">1450000.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt><Dt>2026-07-01</Dt></Dt>
      </Bal>
      <Bal>
        <Tp><CdOrPrtry><Cd>CLBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="KZT">1450000.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt><Dt>2026-07-31</Dt></Dt>
      </Bal>
    </Stmt>
  </BkToCstmrStmt>
</Document>
