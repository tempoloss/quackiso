<?xml version="1.0" encoding="UTF-8"?>
<!-- camt.030 notification of case assignment: the case has been passed on.
     This message carries TWO party pairs - Hdr/Fr and Hdr/To alongside
     Assgnr and Assgne - and in this real file they differ: the notification
     goes to EEEEUS33 while the case is assigned to FFFFUS33. Collapsing them
     into one pair would report the wrong bank.

     Justfn here is a bare code (CANC); camt.031 wraps it in RjctnRsn.

     Shape from the Nivaes/Iso20022Net test resources (MIT),
     Iso20022.UnitTest/Resources/Camt/camt.030.001.04_1. -->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.030.001.04" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<NtfctnOfCaseAssgnmt>
		<Hdr>
			<Id>RESPAB20120317CANC</Id>
			<Fr>
				<Agt>
					<FinInstnId>
						<BICFI>NNNNUS33</BICFI>
					</FinInstnId>
				</Agt>
			</Fr>
			<To>
				<Pty>
					<Id>
						<OrgId>
							<AnyBIC>EEEEUS33</AnyBIC>
						</OrgId>
					</Id>
				</Pty>
			</To>
			<CreDtTm>2012-03-26T10:22:23</CreDtTm>
		</Hdr>
		<Case>
			<Id>EEEE20120325001</Id>
			<Cretr>
				<Pty>
					<Id>
						<OrgId>
							<AnyBIC>EEEEUS33</AnyBIC>
						</OrgId>
					</Id>
				</Pty>
			</Cretr>
		</Case>
		<Assgnmt>
			<Id>NNNNCANC0001200888</Id>
			<Assgnr>
				<Agt>
					<FinInstnId>
						<BICFI>NNNNUS33</BICFI>
					</FinInstnId>
				</Agt>
			</Assgnr>
			<Assgne>
				<Agt>
					<FinInstnId>
						<BICFI>FFFFUS33</BICFI>
					</FinInstnId>
				</Agt>
			</Assgne>
			<CreDtTm>2012-03-26T10:07:23</CreDtTm>
		</Assgnmt>
		<Ntfctn>
			<Justfn>CANC</Justfn>
		</Ntfctn>
	</NtfctnOfCaseAssgnmt>
</Document>
