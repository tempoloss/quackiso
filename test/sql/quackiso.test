1633/05	MD16	-	-	-
88456	NARR	Delivery is not as agreed in purchase order 44558/06	-	-
PS66678	End of contract	-	Paris Solutions	DE89350700644570000

# when the sender does repeat it, the mandate sits at OrgnlMndt/OrgnlMndt — the
# same-named element nested inside the choice wrapper, which a reader taking the
# outer one would read as empty
query TTTTTT
SELECT original_mandate_id, creditor_name, creditor_account, debtor_name,
       debtor_agent_bic, ultimate_debtor_name
FROM read_pain011('testdata/pain011_full_mandate.xml');
----
PS66678	Paris Solutions	FR142066333888050021M05505	Schmitt	TTTTDE48	Schneider

# an amendment carries BOTH states: the mandate it changes and what it becomes.
# The mandate columns are the new state — 100 USD, down from the 1200 the
# original block still states.
query TTTTTTT
SELECT original_mandate_id, mandate_id, amendment_reason, collection_amount,
       currency, sequence_type, frequency
FROM read_pain010('testdata/pain010_amount_amendment.xml');
----
3344/54	3344/54	Change on the contract	100.00000	USD	RCUR	MNTH

# an amendment that changes one account states only that account in the new
# mandate, so the other columns are NULL: what is absent is what does not change
query TTTTT
SELECT coalesce(amendment_originator, '-'), original_mandate_id,
       coalesce(creditor_account, '-'), debtor_account, instructing_agent_bic
FROM read_pain010('testdata/pain010*.xml')
ORDER BY original_mandate_id;
