# ── camt.027-087: investigations ─────────────────────────────────────────────
# The case messages: a claim, the information that answers it, the notification
# that it moved, the refusal, the debit authorisation pair, and the request to
# modify rather than cancel. Grain is the message — nothing in Assgnmt, Case or
# Undrlyg repeats — and every monetary column is the original payment's.
#
# Both spellings of the underlying payment in one query: the initiation (Initn)
# carries a requested execution date, the interbank leg (IntrBk) a settlement
# date. The first row also mixes the party choices — the assigner is a
# Pty/Id/OrgId/AnyBIC, the assignee an Agt/FinInstnId/BICFI.
query TTTTTTTTTT
SELECT assigner, assignee, case_id, case_creator, original_msg_id,
       original_instr_id, original_amount, original_currency,
       coalesce(original_execution_date::VARCHAR, '-'),
       coalesce(original_settlement_date::VARCHAR, '-')
FROM read_camt027('testdata/camt027*.xml')
ORDER BY assignment_id;
----
CUSAFRPP	FFFFFRPP	CNR0505PAY09876543	CUSAFRPP	0903PAY09876543	0903PAY09876543	13498.52000	GBP	2012-03-01	-
FFFFFRPP	UUUUGB2L	CNR0903PAY09876543	CUSAFRPP	345601234	345601234	13498.52000	GBP	-	2012-03-01

# camt.030 carries TWO party pairs and they are not the same pair: the
# notification goes to EEEEUS33 while the case is assigned to FFFFUS33. One pair
# of columns would report the wrong bank.
query TTTTTTTT
SELECT notification_id, notification_from, notification_to, assigner, assignee,
       notification_to <> assignee, justification, notification_created
FROM read_camt030('testdata/camt030_case_assignment.xml');
----
RESPAB20120317CANC	NNNNUS33	EEEEUS33	NNNNUS33	FFFFUS33	true	CANC	2012-03-26 10:22:23

# a refusal has no underlying payment at all: the assignment, the case and the
# reason are the whole message. NFND — the payment was not found.
query TTTTT
SELECT assigner, assignee, case_id, case_creator, rejection_reason
FROM read_camt031('testdata/camt031_reject_investigation.xml');
----
VVVVJPJT	CCCCJPJT	MOD123JPY20120323	CCCCJPJT	NFND

# the case id is the join across the family: the debit authorisation response
# and the modification request belong to the same investigation
query TTTTT
SELECT r.case_id, r.debit_authorised, r.assigner, m.original_instr_id, m.original_amount
FROM read_camt036('testdata/camt036_debit_authorised.xml') r
JOIN read_camt087('testdata/camt087_modify_payment.xml') m USING (case_id);
----
CUSTA201203001	true	ASUPGB2L	CPAY0123456789	52317.48000

# amount_to_debit is what is being asked for and original_amount is what was
# paid: the first edition asks for all of it, the 2012 sample states no amount
# at all and the column is NULL rather than a repeat of the original
query TTTTTT
SELECT cancellation_reason, original_amount, coalesce(amount_to_debit::VARCHAR, '-'),
       coalesce(debit_currency, '-'), original_currency,
       coalesce(amount_to_debit = original_amount, false)
FROM read_camt037('testdata/camt037*.xml')
ORDER BY assignment_id;
----
CUST	12347.56000	12347.56000	EUR	EUR	true
UPAY	52317.48000	-	-	GBP	false

# the 2005 first edition: bare BICs where the modern message has a Pty/Agt
# choice, and the payment stated inline (AssgneInstrId, CcyAmt, ValDt) instead
# of under Initn or IntrBk. Same columns, no special case for the caller.
query TTTTT
SELECT assigner, assignee, original_instr_id, original_amount, original_settlement_date
FROM read_camt037('testdata/camt037_first_edition.xml');
