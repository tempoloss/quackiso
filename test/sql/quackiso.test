# one request may ask about several original messages: a transaction that
# restates OrgnlGrpInf answers under ITS batch, not under the message-level one
query TT
SELECT status_request_id, original_msg_id
FROM read_pacs028('testdata/pacs028_clearing_ids.xml')
ORDER BY status_request_id;
----
STSREQ-DOM-0001-1	BATCH-DOM-01
STSREQ-DOM-0001-2	BATCH-DOM-02

# no <Document> at all: the container sits under the operator's envelope, and
# identity is the container, so the request reads and still joins its payment
query TTTT
SELECT q.msg_id, q.status_request_id, q.original_amount = o.amount, q.original_settlement_date
FROM read_pacs028('testdata/pacs028_envelope.xml') q
JOIN read_pacs008('testdata/pacs008_returned_original.xml') o
  ON q.original_uetr = o.uetr;
----
RTGS-STSREQ-0001	RTGS-STSREQ-0001-1	true	2026-07-15

# one envelope, two families, both naming their transaction <TxInf>: each reader
# owes exactly its own row. A container flag that latched instead of scoping
# would read the cancellation as a second status request, and the reverse.
query TTT
SELECT msg_id, status_request_id, original_uetr
FROM read_pacs028('testdata/pacs028_envelope_two_messages.xml');
