# ── pacs.007: payment reversals ──────────────────────────────────────────────
# A return is the receiver sending money back; a reversal is the SENDER taking
# it back — here the collecting bank undoing its own direct debit. Both amounts
# are exposed, and the difference is the charges the bank kept.
query TTTT
SELECT reversal_id, amount, original_amount, original_amount - amount
FROM read_pacs007('testdata/pacs007_reversal.xml');
