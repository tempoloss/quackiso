# the request and the answer to it: the pacs.028 asks by UETR, the pacs.002 that
# answers names the same payment and the same original message
query TTTTT
SELECT q.status_request_id, r.status, q.original_msg_id = r.original_msg_id,
       q.original_amount = r.original_amount, r.original_instr_id
FROM read_pacs028('testdata/pacs028_status_request.xml') q
JOIN read_pacs002('testdata/pacs002_cbpr_tx.xml') r
  ON q.original_uetr = r.original_uetr;
----
STSREQ-0001-1	ACSC	true	true	INSTR-9001

# an amount in a carried copy is held to the precision of an amount in an
