# and every file in the directory got exactly one row — including the ones
# that are not messages
query II
SELECT count(*), count(*) FILTER (WHERE error IS NOT NULL)
FROM sniff_iso20022('testdata/*.xml');
----
73	4

# audit_addresses: the four postal-address shapes in one message. The mandate
# that lands on 14 November 2026 wants the town and the country in elements of
# their own; what a party is in, and what that costs it, is one row per party.
query TTTTTTTIIIT
SELECT role, party_kind, party_path, coalesce(name, '-'), coalesce(bic, '-'),
       coalesce(town, '-'), coalesce(country, '-'),
       address_lines, longest_address_line, structured_elements, address_format
FROM audit_addresses('testdata/pacs008_address_formats.xml')
ORDER BY party_path;
----
Cdtr	PARTY	CdtTrfTxInf/Cdtr	Hybrid Trading GmbH	-	Frankfurt am Main	DE	2	15	2	HYBRID
CdtrAgt	AGENT	CdtTrfTxInf/CdtrAgt	-	DEUTDEFF	-	-	0	0	0	NONE
Dbtr	PARTY	CdtTrfTxInf/Dbtr	Structured Holdings BV	-	Amsterdam	NL	0	0	5	STRUCTURED
DbtrAgt	AGENT	CdtTrfTxInf/DbtrAgt	ABN AMRO	ABNANL2A	Amsterdam	NL	2	73	2	HYBRID
UltmtCdtr	PARTY	CdtTrfTxInf/UltmtCdtr	Treasury Operations	-	-	US	2	27	1	UNSTRUCTURED

# `finding` is the rule applied, and it is NULL when nothing would be refused:
# two of these five parties would be. The hybrid agent states its town and its
# country, so the format is right and only the line length is wrong; the
# unstructured party left its town inside a free-text line, where the mandate
# cannot see it.
query TTT
SELECT role, address_format, finding
FROM audit_addresses('testdata/pacs008_address_formats.xml')
WHERE finding IS NOT NULL
ORDER BY role;
----
DbtrAgt	HYBRID	an address line of 73 characters, at most 70 permitted
UltmtCdtr	UNSTRUCTURED	address lines with no TwnNm

# every party of the message is a row, and the message identity is on each of
# them, so a glob stays attributable
query TTIII
SELECT any_value(family), any_value(message_id), any_value(record_index),
       count(*), count(finding)
FROM audit_addresses('testdata/pacs008_address_formats.xml');
----
pacs.008	ADDR-FORMATS-1	1	5	2

# the same four shapes on the MT side of the same mandate, spelled in the other
# alphabet: a `:50K:` is free-text lines, a `:57D:` is three of them where the
# hybrid form permits two, a `:59F:` numbers its subfields so `3/BE/BRUSSELS`
# fills a town and a country, and a `:52A:` is a BIC that needs no address
query TTTTTTTIIIT
SELECT role, party_kind, party_path, coalesce(name, '-'), coalesce(bic, '-'),
       coalesce(town, '-'), coalesce(country, '-'),
       address_lines, longest_address_line, structured_elements, address_format
FROM audit_addresses('testdata/mt103_address_formats.txt')
ORDER BY party_path;
----
OrderingCustomer	PARTY	50K	NORTHWIND RETAIL LTD	-	-	-	2	19	0	UNSTRUCTURED
OrderingInstitution	AGENT	52A	-	NWBKGB2LXXX	-	-	0	0	0	NONE
AccountWithInstitution	AGENT	57D	SOUTH RIVER BANK	-	-	-	3	18	0	UNSTRUCTURED
Beneficiary	PARTY	59F	JOHN SMITH	-	BRUSSELS	BE	1	12	2	HYBRID

# and the verdicts, from the same classifier the XML side goes through: the
# numbered option passes and the free-text ones do not
query TTT
SELECT role, address_format, finding
FROM audit_addresses('testdata/mt103_address_formats.txt')
WHERE finding IS NOT NULL
ORDER BY role;
----
AccountWithInstitution	UNSTRUCTURED	address lines with no TwnNm and no Ctry; 3 address lines, at most 2 permitted
OrderingCustomer	UNSTRUCTURED	address lines with no TwnNm and no Ctry

# and the evidence behind the verdict: the lines themselves, so a refusal can be
# acted on without reopening the file. Newlines are folded here only to keep the
# row on one line. A `:52A:` is a BIC with no address at all, and option F still
# has a `2/` line beside its town, so one is NULL and the other is not
query TTI
SELECT role, coalesce(replace(address_text, chr(10), ' | '), '<null>'), address_lines
FROM audit_addresses('testdata/mt103_address_formats.txt')
ORDER BY role;
----
AccountWithInstitution	FLOOR 12 TOWER TWO | 1 HARBOUR ROAD | KOWLOON HONG KONG	3
Beneficiary	HOOGSTRAAT 6	1
OrderingCustomer	226 AWOLOWO WAY 322 | LAGOS NIGERIA	2
OrderingInstitution	<null>	0

# the same column on the XML side, and the reason it is not derivable from the
# counts: `LAGOS NIGERIA` above and `Washington, DC 20220` here are both refused
# for no TwnNm and no Ctry, while a STRUCTURED party has no free line to hand over
query TTIT
SELECT role, coalesce(replace(address_text, chr(10), ' | '), '<null>'),
       address_lines, address_format
FROM audit_addresses('testdata/pacs008_address_formats.xml')
ORDER BY role;
----
Cdtr	Taunusanlage 12 | 4th floor	2	HYBRID
CdtrAgt	<null>	0	NONE
Dbtr	<null>	0	STRUCTURED
DbtrAgt	Gustav Mahlerlaan 10 | Postbus 283, correspondence to the international payments operations desk	2	HYBRID
UltmtCdtr	1500 Pennsylvania Avenue NW | Washington, DC 20220	2	UNSTRUCTURED

# MT identity is the sender's reference and the family the sniffer reports, so
# MT and ISO 20022 rows group together; `record_index` is NULL because MT numbers
# its transactions differently in every message type
query TTIII
SELECT any_value(family), any_value(message_id), count(record_index),
       count(*), count(finding)
FROM audit_addresses('testdata/mt103_address_formats.txt');
----
mt.103	MT103-ADDR-0001	0	4	2

# a statement carries no party field at all: zero rows, and not an error, because
# the file was read and it named nobody
query I
SELECT count(*) FROM audit_addresses('testdata/mt940_statement.txt');
----
0

# a well-formed XML document that is not an ISO 20022 message at all fails the
# same way its readers do
statement error
SELECT * FROM audit_addresses('testdata/pain002_not_a_report.xml');
----
no ISO 20022 message found

# and bytes that are neither wire format are refused before the parser is handed
# them, which is what the guard is for. This is the shape tools/mxgen and
# tools/mtgen exist for, and the only gate on it that runs on push: the fetched
# corpus holds 416 of these, and the sweep does not read them because `.json` is
