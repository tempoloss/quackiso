# ── camt.056: payment cancellation requests ──────────────────────────────────
# A cancellation moves no money: every monetary column is original_*. The
# assignment names who is asking whom, and the transaction names the payment.
query TTTTT
SELECT assigner, assignee, cancellation_id, case_id, cancellation_reason_code
FROM read_camt056('testdata/camt056_request.xml');
----
DEUTDEFFXXX	BNPAFRPPXXX	CXL-0007-1	CASE-4711	DUPL

query TTTT
SELECT original_amount, typeof(original_amount), original_settlement_date, remittance_info
FROM read_camt056('testdata/camt056_request.xml');
----
18500.75000	DECIMAL(38,5)	2026-07-15	Invoice 9001 freight

# the cancellation joins the rest of the lifecycle on the UETR it shares with
# the pacs.008 that settled the payment and the pacs.004 that returned it
query TTT
SELECT c.original_uetr = o.uetr, c.original_uetr = r.original_uetr,
       o.debtor_name = c.original_debtor_name
FROM read_camt056('testdata/camt056_request.xml') c
JOIN read_pacs008('testdata/pacs008_returned_original.xml') o ON c.original_uetr = o.uetr
JOIN read_pacs004('testdata/pacs004_return_chain.xml') r ON c.original_uetr = r.original_uetr;
----
true	true	true

# the request names the payment's instruction id as well as its UETR, so the
# receiver matches it against the pacs.008 that carries it without a lookup
query TT
SELECT c.original_instr_id, c.original_instr_id = p.instr_id
FROM read_camt056('testdata/camt056_request.xml') c
JOIN read_pacs008('testdata/pacs008_prefixed_sample.xml') p ON c.original_uetr = p.uetr;
----
INSTR-9001	true

# A whole-batch cancellation (GrpCxl true) lists no transactions and is still a
# row; the transaction under the SECOND underlying message references BATCH-2,
# not the batch the first Undrlyg cancelled.
query TTTTT
SELECT scope, coalesce(cancellation_id, '-'), coalesce(group_cancellation, '-'),
       original_msg_id, coalesce(cancellation_reason_code, '-')
FROM read_camt056('testdata/camt056_group_cancel.xml')
ORDER BY scope, original_msg_id;
----
GROUP	GRPCXL-77	true	BATCH-1	DUPL
GROUP	-	false	BATCH-2	-
TRANSACTION	CXL-0008-1	-	BATCH-2	TECH

# the batch-cancel row carries the group reason and the counts it stated
query TTT
SELECT original_number_of_txs, cancellation_reason_info, cancellation_originator
FROM read_camt056('testdata/camt056_group_cancel.xml')
WHERE group_cancellation = 'true';
