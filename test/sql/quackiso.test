# name: test/sql/quackiso.test
# description: read_iso20022 flattens camt.053 entries into rows
# group: [quackiso]

require quackiso

# one row per booked entry
query I
SELECT count(*) FROM read_iso20022('testdata/camt053_sample.xml');
----
2

# counterparty resolves to the other side of the flow, and Sts is read whether
# it is plain text (<Sts>BOOK</Sts>) or coded (<Sts><Cd>BOOK</Cd></Sts>)
query TTTT
SELECT entry_ref, credit_debit, status, counterparty_name
FROM read_iso20022('testdata/camt053_sample.xml')
ORDER BY entry_ref;
----
NTRY-0001	DBIT	BOOK	Steppe Logistics JSC
NTRY-0002	CRDT	BOOK	Aral Trading Ltd

# amounts and remittance survive the flatten
query TR
SELECT end_to_end_id, amount
FROM read_iso20022('testdata/camt053_sample.xml')
ORDER BY entry_ref;
----
E2E-INV-90210	250000.0
E2E-REF-44771	75000.5

# camt.053.001.08 regression: party name nested under Pty/Nm, and a non-IBAN
# account carried under Othr/Id. Both were dropped until validated against real
# Goldman Sachs v8/US statements.
query TTT
SELECT credit_debit, counterparty_name, counterparty_iban
FROM read_iso20022('testdata/camt053_v8_sample.xml');
----
DBIT	Steppe Logistics JSC	9987654321

query TT
SELECT account_iban, currency
FROM read_iso20022('testdata/camt053_v8_sample.xml');
----
0123456789	USD

# camt.054 notification: container is <Ntfctn>, not <Stmt>. Same reader. Also
# checks structured remittance (Strd/CdtrRefInf/Ref) when there is no Ustrd.
query TTTT
SELECT statement_id, credit_debit, counterparty_name, remittance_info
FROM read_iso20022('testdata/camt054_sample.xml');
----
NTFCTN-KZ-01	CRDT	Aral Trading Ltd	INV-2026-0731

# pacs.008 credit transfer, one row per CdtTrfTxInf. This message is namespace
# PREFIXED (Doc:) — copying the subtree verbatim used to produce an ill-formed
# document, so this locks the normalisation.
query TTRT
SELECT end_to_end_id, uetr, amount, currency
FROM read_pacs008('testdata/pacs008_prefixed_sample.xml');
----
E2E-PFX-9001	7a6f1c62-9c3e-4f1a-9b21-8d5c4e2f7a10	18500.75	EUR

# agents resolve from BICFI (the later spelling of BIC)
query TTTT
SELECT debtor_name, debtor_agent_bic, creditor_name, creditor_agent_bic
FROM read_pacs008('testdata/pacs008_prefixed_sample.xml');
----
QMA Holding LLP	DEUTDEFFXXX	Steppe Logistics JSC	BNPAFRPPXXX
