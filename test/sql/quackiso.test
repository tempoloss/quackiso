# ── parallel scan ────────────────────────────────────────────────────────────
# A glob is parsed by one worker per file (bounded, file-level: XML has no safe
# split points, so a single document is never divided). Totals must be exactly
# the totals of the sequential scan — order may differ, money may not.
query TT
SELECT count(*), SUM(amount)
FROM read_pacs004('testdata/pacs004_*.xml', threads := 4);
----
5	94601.25000

query TT
SELECT count(*), SUM(amount)
FROM read_pacs004('testdata/pacs004_*.xml', threads := 1);
----
5	94601.25000

# a malformed file fails the whole parallel scan, exactly as it does the
# sequential one — an error in any worker is the query's error. One malformed
# file per glob: camt053_*.xml holds two, and with four workers the one that
# reaches its error first decides the message, which is a race and not a
# contract. [bdesv] takes the bad amount, [destv] the truncated document.
statement error
SELECT count(*) FROM read_iso20022('testdata/camt053_[bdesv]*.xml', threads := 4);
----
fraction digits

statement error
SELECT count(*) FROM read_iso20022('testdata/camt053_[destv]*.xml', threads := 4);
----
tag not closed

# ── pacs.009: financial institution transfers ────────────────────────────────
# The parties of a pacs.009 are BANKS, and the COV variant carries the customer
# transfer it settles. Dropping the underlying block would reproduce exactly
# the opacity MT202COV was invented to remove: the interbank leg would say
# Deutsche->BNP and the actual payer and payee would vanish.
query TTTT
SELECT debtor_fi, creditor_fi, underlying_debtor_name, underlying_creditor_name
FROM read_pacs009('testdata/pacs009_cover.xml');
----
DEUTDEFFXXX	BNPAFRPPXXX	QMA Holding LLP	Steppe Logistics JSC

query TTTT
SELECT amount, typeof(amount), settlement_date, underlying_remittance_info
FROM read_pacs009('testdata/pacs009_cover.xml');
----
18500.75000	DECIMAL(38,5)	2026-07-15	Invoice 9001 freight

# the cover settles the same business payment the pacs.008 carried: the
# underlying customer sides must agree with the customer-leg message
query TT
