Best Bank	55512/04	558823	33144568	AAAAUS22
Moulin et Cie	66613/06	-	FR131005203006040010M04304	NULL

# the acceptance report answers all three requests with one shape, so
# original_msg_name_id is the only thing that says which; a refusal carries the
# reason and no mandate detail
query TTTTT
SELECT original_msg_name_id, accepted, coalesce(rejection_reason, '-'),
       original_mandate_id, coalesce(sequence_type, '-')
FROM read_pain012('testdata/pain012*.xml')
ORDER BY original_msg_id;
