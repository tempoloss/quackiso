# ── pain.009-012: mandate lifecycle ──────────────────────────────────────────
# pain.008 names a mandate by id; these four read the mandate itself. The grain
# is the record element, so a message stating three mandates is three rows, and
# the header block is carried into every one of them.
query TTTTTTTT
SELECT mandate_id, sequence_type, frequency, first_collection_date,
       final_collection_date, collection_amount, currency, ultimate_debtor_name
FROM read_pain009('testdata/pain009_sepa_mandate.xml');
----
09/345	RCUR	MNTH	2013-02-04	2013-11-04	50.00000	EUR	Fischer

# a mandate that has not been registered yet has no id at all, only the id of
# the request; a one-off (OOFF) has no frequency. Neither is missing data.
query TTTTTT
SELECT coalesce(mandate_id, '-'), mandate_request_id, sequence_type,
       coalesce(frequency, '-'), creditor_account, debtor_account
FROM read_pain009('testdata/pain009*.xml')
ORDER BY mandate_request_id;
----
09/345	09/345	RCUR	MNTH	FR1430041020030300015M02606	NULL
55513	55513	OOFF	-	5566771	FR142006303007050021M05405
-	Johns/005	RCUR	MNTH	76543	5544732

# same typing discipline as the payment readers: collection dates are DATE,
# the amount is the exact DECIMAL and the header time is a TIMESTAMP
query TTTT
SELECT typeof(created), created, typeof(first_collection_date), typeof(collection_amount)
FROM read_pain009('testdata/pain009_sepa_mandate.xml');
----
TIMESTAMP	2012-12-16 14:25:00	DATE	DECIMAL(38,5)

# a cancellation naming nothing but the mandate id is complete: every detail
# column is NULL because the sender repeated nothing, not because it was
# dropped. NARR means "the reason is the text", so the text is a column.
query TTTTT
SELECT original_mandate_id, cancellation_reason,
       coalesce(cancellation_reason_info, '-'), coalesce(creditor_name, '-'),
       coalesce(debtor_account, '-')
FROM read_pain011('testdata/pain011*.xml')
ORDER BY original_mandate_id;
