BNPAFRPP	CUSCFRPP	E20050418027	12347.56000	2005-04-18

# a modification is not a cancellation: the payment stays and the difference is
# a subtraction, because both amounts are columns of one row
query TTTTTT
SELECT original_instr_id, original_amount, modified_amount,
       original_amount - modified_amount, modified_currency,
       length(modified_remittance_info) > 0
FROM read_camt087('testdata/camt087_modify_payment.xml');
