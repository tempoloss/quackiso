# name: test/sql/quackiso.test
# description: read_iso20022 flattens camt.053 entries into rows
# group: [quackiso]

require quackiso

# one row per booked entry
query I
SELECT count(*) FROM read_iso20022('testdata/camt053_sample.xml');
----
2

# counterparty resolves to the other side of the flow, and Sts is read whether
# it is plain text (<Sts>BOOK</Sts>) or coded (<Sts><Cd>BOOK</Cd></Sts>)
query TTTT
SELECT entry_ref, credit_debit, status, counterparty_name
FROM read_iso20022('testdata/camt053_sample.xml')
ORDER BY entry_ref;
----
NTRY-0001	DBIT	BOOK	Steppe Logistics JSC
NTRY-0002	CRDT	BOOK	Aral Trading Ltd

# amounts and remittance survive the flatten
query TT
SELECT end_to_end_id, amount
FROM read_iso20022('testdata/camt053_sample.xml')
ORDER BY entry_ref;
----
E2E-INV-90210	250000.00000
E2E-REF-44771	75000.50000

# A statement gzipped is the same statement. Banks ship .xml.gz as often as
# .xml, and gzip announces itself in its first two bytes, so there is nothing to
# configure and nothing to unpack first.
query I
SELECT count(*) FROM read_iso20022('testdata/camt053_sample.xml.gz');
----
2

# every column, not only the count, and in both directions: a row the gz scan
# invented would be invisible to a one-sided difference
query I
SELECT count(*) FROM (
    (
        SELECT * EXCLUDE (source_file) FROM read_iso20022('testdata/camt053_sample.xml')
        EXCEPT ALL
        SELECT * EXCLUDE (source_file) FROM read_iso20022('testdata/camt053_sample.xml.gz')
    )
    UNION ALL
    (
        SELECT * EXCLUDE (source_file) FROM read_iso20022('testdata/camt053_sample.xml.gz')
        EXCEPT ALL
        SELECT * EXCLUDE (source_file) FROM read_iso20022('testdata/camt053_sample.xml')
    )
);
----
0

# a glob may mix the two, one worker per file. `threads := 2` rather than the
# default, so the parallel path runs even where the machine has one core
query I
SELECT count(*) FROM read_iso20022('testdata/camt053_sample.xml*', threads := 2);
----
4

# the sniffer opens a file the way the readers do, so it sees through gzip too
query TTIT
SELECT message_type, family, records, reader
FROM sniff_iso20022('testdata/camt053_sample.xml.gz');
----
camt.053.001.02	camt.053	2	read_iso20022

# camt.053.001.08 regression: party name nested under Pty/Nm, and a non-IBAN
# account carried under Othr/Id. Both were dropped until validated against real
# Goldman Sachs v8/US statements.
query TTT
SELECT credit_debit, counterparty_name, counterparty_iban
FROM read_iso20022('testdata/camt053_v8_sample.xml');
----
DBIT	Steppe Logistics JSC	9987654321

query TT
SELECT account_iban, currency
FROM read_iso20022('testdata/camt053_v8_sample.xml');
----
0123456789	USD

# camt.054 notification: container is <Ntfctn>, not <Stmt>. Same reader. Also
# checks structured remittance (Strd/CdtrRefInf/Ref) when there is no Ustrd.
query TTTT
SELECT statement_id, credit_debit, counterparty_name, remittance_info
FROM read_iso20022('testdata/camt054_sample.xml');
----
NTFCTN-KZ-01	CRDT	Aral Trading Ltd	INV-2026-0731

# camt.052 is the third message read_iso20022 covers: <Rpt> instead of <Stmt>,
# same <Ntry> children
query TTTT
SELECT statement_id, entry_ref, credit_debit, status
FROM read_iso20022('testdata/camt052_report.xml')
ORDER BY entry_ref;
----
RPT-KZ-88-0729	RPT-0001	CRDT	PDNG
RPT-KZ-88-0729	RPT-0002	DBIT	BOOK
RPT-KZ-88-0729	RPT-0003	CRDT	BOOK

# CDATA is content: a group-level leaf wrapped in it used to read NULL, while
# the same bytes inside a transaction subtree read fine
query TT
SELECT DISTINCT msg_id, account_iban FROM read_iso20022('testdata/camt052_report.xml');
----
RPT-2026-07-29-0001	KZ86125KZT5004100100

# the counterparty is one party: a name from the correct side beside an account
# from the other describes two people in one row, so an unnamed payer is NULL
# and its account still stands. RPT-0003 is the other half of that rule: the
# ultimate party belongs to its own side, so it names the payer beside the
# account the payer paid from, rather than being skipped for having no account
# element of its own.
query TTT
SELECT entry_ref, counterparty_name, counterparty_iban
FROM read_iso20022('testdata/camt052_report.xml')
ORDER BY entry_ref;
----
RPT-0001	NULL	KZ55777KZT5011300300
RPT-0002	Aral Trading Ltd	KZ11009KZT5099200200
RPT-0003	Kazpost JSC	KZ33444KZT5077700700

# February 31st is not a date. NULL, not March 3rd.
query TT
SELECT entry_ref, booking_date
FROM read_iso20022('testdata/camt052_report.xml')
ORDER BY entry_ref;
----
RPT-0001	2026-07-29 00:00:00
RPT-0002	NULL
RPT-0003	2026-07-29 00:00:00

# the sniffer reads CDATA too, and camt.052 routes to read_iso20022
query TTTIT
SELECT message_type, family, msg_id, records, reader
FROM sniff_iso20022('testdata/camt052_report.xml');
----
camt.052.001.08	camt.052	RPT-2026-07-29-0001	3	read_iso20022

# a namespace is not a message: the binding resolves a family, and with no
# <Document>, no container and no record element the file still has to come
# back as an error rather than be routed to a reader that would abort on it
query TTIT
SELECT family, reader, records, error IS NOT NULL
FROM sniff_iso20022('testdata/envelope_no_message.xml');
----
pacs.008	read_pacs008	0	true

# pacs.008 credit transfer, one row per CdtTrfTxInf. This message is namespace
# PREFIXED (Doc:) — copying the subtree verbatim used to produce an ill-formed
# document, so this locks the normalisation.
query TTTTTT
SELECT instr_id, end_to_end_id, tx_id, uetr, amount, currency
FROM read_pacs008('testdata/pacs008_prefixed_sample.xml');
----
INSTR-9001	E2E-PFX-9001	TXID-PFX-9001	7a6f1c62-9c3e-4f1a-9b21-8d5c4e2f7a10	18500.75000	EUR

# agents resolve from BICFI (the later spelling of BIC)
query TTTT
SELECT debtor_name, debtor_agent_bic, creditor_name, creditor_agent_bic
FROM read_pacs008('testdata/pacs008_prefixed_sample.xml');
----
QMA Holding LLP	DEUTDEFFXXX	Steppe Logistics JSC	BNPAFRPPXXX

# the payment and the camt.029 that refuses cancelling it name one transaction
query TT
SELECT p.tx_id = r.original_tx_id, p.instr_id = r.original_instr_id
FROM read_pacs008('testdata/pacs008_prefixed_sample.xml') p
JOIN read_camt029('testdata/camt029_rejected_tx.xml') r ON p.uetr = r.original_uetr;
----
true	true

# ── typing ───────────────────────────────────────────────────────────────────
# Dates are real DATE/TIMESTAMP, not VARCHAR: the corpus mixes `2019-01-23`
# with `2023-10-01T13:37:14.000Z`, so the column has to hold both. Proven by
# doing date arithmetic the engine could not do on a string.
#
# Amounts are DECIMAL, not DOUBLE. Money through a float is a real defect, not
# a stylistic one — see the exactness test below.
query TTT
SELECT typeof(booking_date), typeof(value_date), typeof(amount)
FROM read_iso20022('testdata/camt053_sample.xml') LIMIT 1;
----
TIMESTAMP	TIMESTAMP	DECIMAL(38,5)

query TT
SELECT booking_date, value_date - booking_date
FROM read_iso20022('testdata/camt053_sample.xml')
ORDER BY entry_ref LIMIT 1;
----
2026-07-29 00:00:00	00:00:00

# ── pain.001: credit transfer initiation ─────────────────────────────────────
# The payer lives on the <PmtInf> group, not on the transaction. Two groups
# with different debtors prove the context is carried down AND replaced.
query I
SELECT count(*) FROM read_pain001('testdata/pain001_sample.xml');
----
3

query TTT
SELECT payment_info_id, debtor_name, count(*)
FROM read_pain001('testdata/pain001_sample.xml')
GROUP BY 1, 2 ORDER BY 1;
----
PMTINF-A	QMA Holding LLP	2
PMTINF-B	QMA Subsidiary GmbH	1

# execution date is DATE, and is read from both the <Dt> and <DtTm> wrappings
query TTT
SELECT payment_info_id, typeof(requested_execution_date), requested_execution_date
FROM read_pain001('testdata/pain001_sample.xml')
GROUP BY 1, 2, 3 ORDER BY 1;
----
PMTINF-A	DATE	2026-08-03
PMTINF-B	DATE	2026-08-10

# ChrgBr inherits from the group unless the transaction overrides it
query TTT
SELECT end_to_end_id, charge_bearer, remittance_info
FROM read_pain001('testdata/pain001_sample.xml')
ORDER BY end_to_end_id;
----
E2E-A-1	SLEV	Invoice A-1
E2E-A-2	SLEV	REF-A-2
E2E-B-1	DEBT	Freight B-1

# non-IBAN accounts and clearing-system member ids resolve too
query TTT
SELECT end_to_end_id, debtor_account, creditor_account
FROM read_pain001('testdata/pain001_sample.xml')
WHERE payment_info_id = 'PMTINF-B';
----
E2E-B-1	0099887766	1234567890

# ── exact amounts ────────────────────────────────────────────────────────────
# 0.10 + 0.20 + 0.30 + 1500.10 is 1500.7000000000003 in binary floating point.
# This assertion is the whole reason amounts are parsed straight from the wire
# string into a scaled integer: on DOUBLE it fails.
query T
SELECT SUM(amount) FROM read_iso20022('testdata/camt053_decimal_sample.xml')
WHERE credit_debit = 'DBIT';
----
1500.70000

# and the sum is exactly equal to the literal, not merely close to it
query T
SELECT SUM(amount) = 1500.70 FROM read_iso20022('testdata/camt053_decimal_sample.xml')
WHERE credit_debit = 'DBIT';
----
true

# 18 significant digits is legal ISO 20022 and does not fit a 64-bit
# DECIMAL(18,5); it survives here because the column is DECIMAL(38,5).
query T
SELECT amount FROM read_iso20022('testdata/camt053_decimal_sample.xml')
WHERE entry_ref = 'DEC-BIG';
----
123456789012345678.00000

# five fraction digits, the ISO 20022 maximum, kept exactly. Not hypothetical:
# prog-nov's pacs.008 carries 5013090.23491, so scale 2 would reject real files.
query T
SELECT amount FROM read_iso20022('testdata/camt053_decimal_sample.xml')
WHERE entry_ref = 'DEC-5DP';
----
5013090.23491

# a malformed amount is an error, never a NULL that would vanish from a SUM
statement error
SELECT amount FROM read_iso20022('testdata/camt053_bad_amount.xml');
----
fraction digits

# ── paths ────────────────────────────────────────────────────────────────────
# A URI is refused at bind time with a message that names the reason, rather
# than failing obscurely mid-scan. See docs/adr/0002-no-remote-paths.md.
statement error
SELECT * FROM read_iso20022('s3://bucket/statements.xml');
----
s3:// paths are not supported

# a Windows drive letter is a path, not a URI, and must not be mistaken for one
statement error
SELECT * FROM read_iso20022('Z:/no/such/statement.xml');
----
no files matched

# globs expand, and every row records which file it came from
query TT
SELECT source_file, count(*)
FROM read_iso20022('testdata/camt053_sample.xml')
GROUP BY 1;
----
testdata/camt053_sample.xml	2

# ── pacs.004: payment returns ────────────────────────────────────────────────
# The return chain is not the payment chain. <RtrChain> describes the return, so
# its debtor is whoever gives the money back — the ORIGINAL CREDITOR. Reading it
# straight into original_debtor_name would name the wrong party with full
# confidence. The join against the original pacs.008 on the shared UETR is what
# holds the crossing in place: both sides must agree.
query TTTT
SELECT r.original_debtor_name, o.debtor_name,
       r.original_creditor_name, o.creditor_name
FROM read_pacs004('testdata/pacs004_return_chain.xml') r
JOIN read_pacs008('testdata/pacs008_returned_original.xml') o
  ON r.original_uetr = o.uetr;
----
QMA Holding LLP	QMA Holding LLP	Steppe Logistics JSC	Steppe Logistics JSC

# the return's own references and dates, and the message it points back at
query TTTTTT
SELECT return_id, original_msg_id, amount, currency,
       settlement_date, original_settlement_date
FROM read_pacs004('testdata/pacs004_return_chain.xml');
----
1	PACS8-PFX-0001	18500.75000	EUR	2026-07-22	2026-07-15

query TTT
SELECT typeof(amount), typeof(settlement_date), typeof(original_settlement_date)
FROM read_pacs004('testdata/pacs004_return_chain.xml');
----
DECIMAL(38,5)	DATE	DATE

# A partial return: 74750.00 came back out of a 74900.00 payment because the
# returning bank kept charges. One amount column would report this as a full
# reversal, so both are exposed and the difference is queryable.
query TTTT
SELECT amount, original_amount, original_amount - amount, amount < original_amount
FROM read_pacs004('testdata/pacs004_partial_return.xml');
----
74750.00000	74900.00000	150.00000	true

# same file, pre-2009 vocabulary: RtrRsn/AddtlRtrRsnInf/RtrOrgtr rather than
# Rsn/AddtlInf/Orgtr, and a message container named after the message version
# (<pacs.004.001.01>) instead of <PmtRtr>
query TTT
SELECT return_reason_code, return_reason_info, return_originator
FROM read_pacs004('testdata/pacs004_partial_return.xml');
----
NARR	accepted payment cancellation request	Steppe Logistics JSC

# <OrgnlTxRef> keeps the ORIGINAL sides, so nothing is crossed when it is
# present. This message is also namespace prefixed (urn2:) and states its
# settlement date once on <GrpHdr>, which is carried down.
query TTTTT
SELECT original_debtor_name, original_debtor_account,
       original_creditor_name, original_creditor_account, settlement_date
FROM read_pacs004('testdata/pacs004_sepa_return.xml');
----
Aral Trading Ltd	DE65500105176582659391	Louis Dupont	DE89370400440532013002	2026-07-03

# an originator identified only by BIC still resolves to one column
query TTT
SELECT return_reason_code, return_originator, remittance_info
FROM read_pacs004('testdata/pacs004_sepa_return.xml');
----
AC04	NTSBDEB1XXX	rent july

# A reason stated once on the group is carried into every transaction that has
# none, and a transaction with its own reason block replaces the whole block —
# code, text and originator together, never mixed across levels.
query TTTTT
SELECT return_id, original_msg_id, return_reason_code,
       coalesce(return_reason_info, '-'), coalesce(return_originator, '-')
FROM read_pacs004('testdata/pacs004_group_reason.xml')
ORDER BY return_id;
----
RTN-1	PAIN-BATCH-77	AC04	account closed 2026-06-30	Bank of Astana
RTN-2	OTHER-BATCH-9	MS03	-	-

# ── pain.002: payment status reports ─────────────────────────────────────────
# A bank that rejects or accepts a whole batch says so once, at group level, and
# details nothing. One row per transaction would return NOTHING for this file
# while the message plainly says ACCP over three transactions.
query TTTTT
SELECT status_level, status, original_msg_id, original_number_of_txs,
       original_control_sum
FROM read_pain002('testdata/pain002_group_only.xml');
----
GROUP	ACCP	QMA/260928/CCT001	3	11500000.00000

# and that row carries no amount and no payment group, because the message
# stated neither
query T
SELECT amount IS NULL AND original_payment_info_id IS NULL AND status_id IS NULL
FROM read_pain002('testdata/pain002_group_only.xml');
----
true

# every level is emitted, so a three-level report is 1 + 3 + 3 rows
query TT
SELECT status_level, count(*)
FROM read_pain002('testdata/pain002_partial_batch.xml')
GROUP BY 1 ORDER BY 1;
----
GROUP	1
PAYMENT_INFO	3
TRANSACTION	3

# each transaction reports the payment group it actually sits in: the group
# context is cleared when the group closes, so no row inherits a neighbour's id
query TTT
SELECT status_id, original_payment_info_id, status
FROM read_pain002('testdata/pain002_partial_batch.xml')
WHERE status_level = 'TRANSACTION' ORDER BY status_id;
----
STS-1	FilA20260212TC01	ACCP
STS-2	FilA20260212TC02	ACCP
STS-3	FilA20260212TC03	RJCT

# a payment group states only what it stated: two of the three carry no status
query TT
SELECT original_payment_info_id, coalesce(status, '-')
FROM read_pain002('testdata/pain002_partial_batch.xml')
WHERE status_level = 'PAYMENT_INFO' ORDER BY 1;
----
FilA20260212TC01	-
FilA20260212TC02	-
FilA20260212TC03	RJCT

# Only transaction rows carry an amount, so the coarser rows cannot double-count:
# the sum of the rows equals the control sum the bank echoed back.
query T
SELECT (SELECT SUM(amount) FROM read_pain002('testdata/pain002_partial_batch.xml')
        WHERE status_level = 'TRANSACTION')
     = (SELECT original_control_sum FROM read_pain002('testdata/pain002_partial_batch.xml')
        WHERE status_level = 'GROUP');
----
true

# the rejection reason, who reported it, and the typed acceptance timestamp
query TTTT
SELECT status_id, reason_code, reason_info, reason_originator
FROM read_pain002('testdata/pain002_partial_batch.xml')
WHERE status = 'RJCT' AND status_level = 'TRANSACTION';
----
STS-3	AC01	creditor account number invalid	Handelsbanken

query TTTT
SELECT typeof(acceptance_date_time), acceptance_date_time,
       typeof(requested_execution_date), requested_execution_date
FROM read_pain002('testdata/pain002_partial_batch.xml')
WHERE status_id = 'STS-1';
----
TIMESTAMP	2026-03-16 11:43:55	DATE	2026-03-16

# pain.002.001.02 puts transaction statuses outside any payment group, and spells
# the reason block StsRsn/StsOrgtr. The payment group id is NULL here, not the
# id of some other group, and the older spellings still read.
query TTTTT
SELECT status_level, coalesce(original_payment_info_id, '-'), coalesce(status, '-'),
       coalesce(reason_code, '-'), coalesce(reason_originator, '-')
FROM read_pain002('testdata/pain002_no_payment_group.xml')
ORDER BY status_level;
----
GROUP	-	-	-	-
TRANSACTION	-	RJCT	AM05	Bank of Astana

# ── message identity ─────────────────────────────────────────────────────────
# A file of the wrong type produces no rows, and no rows with no error is
# indistinguishable from a bank that reported nothing. Each reader checks that it
# saw the element it exists to read.

# well-formed XML named after a pain.002, actually an importer mapping
statement error
SELECT * FROM read_pain002('testdata/pain002_not_a_report.xml');
----
no <CstmrPmtStsRpt> found

# pain.002.001.01 is a genuine status report with a different structure; it is
# refused by name rather than half-read into NULL columns
statement error
SELECT * FROM read_pain002('testdata/pain002_v1_unsupported.xml');
----
no <OrgnlGrpInfAndSts> found

statement error
SELECT * FROM read_pacs004('testdata/camt053_sample.xml');
----
no <PmtRtr> found

statement error
SELECT * FROM read_pacs008('testdata/pacs004_return_chain.xml');
----
no <FIToFICstmrCdtTrf> found

statement error
SELECT * FROM read_pain001('testdata/pacs004_return_chain.xml');
----
no <CstmrCdtTrfInitn> found

statement error
SELECT * FROM read_iso20022('testdata/pacs004_return_chain.xml');
----
no <Stmt>, <Ntfctn> or <Rpt> found

# An account with no movements is a valid statement with no entries, so the camt
# check is on the container and not on the entries: this file must return zero
# rows and no error.
query I
SELECT count(*) FROM read_iso20022('testdata/camt053_empty_statement.xml');
----
0

# ── UETR ─────────────────────────────────────────────────────────────────────
# The reference that follows one payment across message families. pain.001 only
# made it mandatory in the 2019 versions, so an instruction without one reads as
# NULL rather than as an invented id.
query TT
SELECT end_to_end_id, coalesce(uetr, '-')
FROM read_pain001('testdata/pain001_sample.xml')
ORDER BY end_to_end_id;
----
E2E-A-1	3f1d9c74-5b2a-4e08-9a6f-2c7d15e83b40
E2E-A-2	-
E2E-B-1	-

# what the payment was for survives into the status report
query TT
SELECT status_id, remittance_info
FROM read_pain002('testdata/pain002_partial_batch.xml')
WHERE remittance_info IS NOT NULL;
----
STS-1	message to beneficiary

# kept here rather than in the pain.002 section because the point is the
# reference: the 2019-generation report carries the UETR the .03 editions have
# no element for, and it answers the initiation that sent it
query TTTT
SELECT status_level, status_id, original_uetr, original_end_to_end_id
FROM read_pain002('testdata/pain002_cbpr_uetr.xml')
WHERE status_level = 'TRANSACTION';
----
TRANSACTION	STS-CBPR-1	3f1d9c74-5b2a-4e08-9a6f-2c7d15e83b40	E2E-A-1

query TTT
SELECT s.status, s.original_uetr = i.uetr,
       s.original_end_to_end_id = i.end_to_end_id
FROM read_pain002('testdata/pain002_cbpr_uetr.xml') s
JOIN read_pain001('testdata/pain001_sample.xml') i ON s.original_uetr = i.uetr;
----
ACSP	true	true

# ── pacs.002: FI-to-FI payment status reports ────────────────────────────────
# One Document can hold several complete FIToFIPmtStsRpt messages, each with its
# own GrpHdr. Every piece of carried context resets at each message — or the
# second report's transactions would answer under the first report's ids.
query TTTT
SELECT msg_id, status_id, status, original_msg_id
FROM read_pacs002('testdata/pacs002_two_reports.xml')
WHERE status_level = 'TRANSACTION' ORDER BY msg_id;
----
STS-A-260730	STS-A/1	RJCT	BATCH-A
STS-B-260730	STS-B/1	ACSC	BATCH-B

# both group blocks are emitted too, status NULL because neither stated one
query TT
SELECT status_level, count(*)
FROM read_pacs002('testdata/pacs002_two_reports.xml')
GROUP BY 1 ORDER BY 1;
----
GROUP	2
TRANSACTION	2

# the rejection's reason block, and the original amount from the carried copy
query TTTT
SELECT reason_code, reason_info, original_amount, original_settlement_date
FROM read_pacs002('testdata/pacs002_two_reports.xml')
WHERE status = 'RJCT';
----
AM05	duplicate of TX-A-0	1025.00000	2026-07-29

# a batch accepted at group level with no transaction detail is one row, not
# zero rows; this message is also namespace-prefixed (Doc:)
query TTTT
SELECT status_level, status, original_msg_id, original_msg_name_id
FROM read_pacs002('testdata/pacs002_group_only.xml');
----
GROUP	ACCP	PACS8-PFX-0001	pacs.008.001.09

# CBPR+-era shape: no group block at all — the original message is referenced
# per transaction, and per-transaction agents override the group header pair
query TTTT
SELECT original_msg_id, original_uetr, instructing_agent_bic, instructed_agent_bic
FROM read_pacs002('testdata/pacs002_cbpr_tx.xml');
----
PACS8-PFX-0001	7a6f1c62-9c3e-4f1a-9b21-8d5c4e2f7a10	BNPAFRPPXXX	DEUTDEFFXXX

query TT
SELECT typeof(acceptance_date_time), acceptance_date_time
FROM read_pacs002('testdata/pacs002_cbpr_tx.xml');
----
TIMESTAMP	2026-07-30 10:59:14

# ── pacs.028: FI-to-FI payment status requests ───────────────────────────────
# A status request carries no status of its own, only references and, when it
# includes one, a carried copy of the original. Grain: one row per TxInf.
query TI
SELECT scope, count(*)
FROM read_pacs028('testdata/pacs028_status_request.xml')
GROUP BY scope ORDER BY scope;
----
TRANSACTION	2

# the fully-referenced request row: ids, the carried amount, and both parties
query TTTTTT
SELECT status_request_id, original_msg_id, original_uetr, original_amount,
       original_debtor_name, original_creditor_name
FROM read_pacs028('testdata/pacs028_status_request.xml')
WHERE original_uetr = '7a6f1c62-9c3e-4f1a-9b21-8d5c4e2f7a10';
----
STSREQ-0001-1	PACS8-PFX-0001	7a6f1c62-9c3e-4f1a-9b21-8d5c4e2f7a10	18500.75000	QMA Holding LLP	Steppe Logistics JSC

# a bare-UETR request still yields a row; original_msg_id is inherited from the
# message-level OrgnlGrpInf, and the missing carried copy leaves amount NULL
query TTT
SELECT status_request_id, original_msg_id, original_amount IS NULL
FROM read_pacs028('testdata/pacs028_status_request.xml')
WHERE status_request_id = 'STSREQ-0001-2';
----
STSREQ-0001-2	PACS8-PFX-0001	true

# the request joins the payment it asks about on the shared UETR
query TTT
SELECT q.original_amount = o.amount, q.original_debtor_name = o.debtor_name,
       q.original_msg_id = o.msg_id
FROM read_pacs028('testdata/pacs028_status_request.xml') q
JOIN read_pacs008('testdata/pacs008_returned_original.xml') o
  ON q.original_uetr = o.uetr;
----
true	true	true

# a request for a whole original message with no transaction detail is one
# GROUP row, not zero; this file is also namespace-prefixed (Doc:)
query TTTTT
SELECT scope, msg_id, original_msg_id, original_msg_name_id,
       status_request_id IS NULL
FROM read_pacs028('testdata/pacs028_group_only.xml');
----
GROUP	STSREQ-GRP-0001	BATCH-2026-07-15-01	pacs.008.001.09	true

# several requests in one Document: carried context resets at each container
query TT
SELECT msg_id, original_msg_id
FROM read_pacs028('testdata/pacs028_two_requests.xml')
ORDER BY msg_id;
----
STSREQ-A	BATCH-A
STSREQ-B	BATCH-B

# both grains in one Document, transaction request first: the flag that decides
# whether a closing container owes a GROUP row is cleared at every container, or
# the batch question asked second comes back as no row at all
query TTT
SELECT msg_id, scope, original_msg_id
FROM read_pacs028('testdata/pacs028_mixed_grains.xml')
ORDER BY msg_id;
----
STSREQ-MIX-A	TRANSACTION	BATCH-MIX-A
STSREQ-MIX-B	GROUP	BATCH-MIX-B

# the domestic clearing shape: no BIC on either side, so the agent columns carry
# a clearing-system member id and a proprietary operator id
query TT
SELECT DISTINCT instructing_agent_bic, instructed_agent_bic
FROM read_pacs028('testdata/pacs028_clearing_ids.xml');
----
021000021	KZ-RTGS-0044

# a request may name the original by instruction and transaction id instead of a
# UETR, and the carried copy may price it the pain way (<Amt><InstdAmt>)
query TTTTTTT
SELECT status_request_id, original_instr_id, original_tx_id, original_amount,
       original_currency, original_debtor_name, original_creditor_name
FROM read_pacs028('testdata/pacs028_clearing_ids.xml')
WHERE original_tx_id IS NOT NULL;
