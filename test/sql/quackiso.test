1030123456789	MT103	1030123456789	2012-03-27	-	true

# and the pair that is one conversation: the bank asks for a debit
# authorisation, the customer answers with the payment's detail — same case,
# same instruction
query TTTT
SELECT q.case_id, q.original_instr_id, q.cancellation_reason, i.remittance_info IS NOT NULL
FROM read_camt037('testdata/camt037_debit_authorisation.xml') q
JOIN read_camt028('testdata/camt028_initiation_info.xml') i
  ON q.case_id = i.case_id AND q.original_instr_id = i.original_instr_id;
