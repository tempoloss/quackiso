pain.009.001.03	true	-	JMP06/3345	RCUR
pain.011.001.03	true	-	JMP06/3345	RCUR

# and the two halves join: the report answers the initiation by message id, so
# "which mandate requests were accepted" is one query over two files
query TTTT
SELECT r.msg_id, r.mandate_request_id, a.accepted, a.original_mandate_id
FROM read_pain009('testdata/pain009_mandate.xml') r
JOIN read_pain012('testdata/pain012_accepted.xml') a
  ON a.original_msg_id = r.msg_id;
