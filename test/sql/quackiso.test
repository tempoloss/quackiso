# the interbank arm of the same reader: an end-to-end id and a settlement date,
# and a modification that changes only the remittance information
query TTTTTT
SELECT original_msg_id, original_msg_name_id, original_end_to_end_id,
       original_settlement_date, coalesce(modified_amount::VARCHAR, '-'),
       length(modified_remittance_info) > 0
FROM read_camt087('testdata/camt087_interbank_modification.xml');
