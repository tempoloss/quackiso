       c.underlying_creditor_account = o.creditor_account
FROM read_pacs009('testdata/pacs009_cover.xml') c
JOIN read_pacs008('testdata/pacs008_returned_original.xml') o
  ON c.end_to_end_id = o.end_to_end_id;
----
true	true

