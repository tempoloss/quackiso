# Makefiles and shell/test scripts must stay LF or the toolchain breaks
# (make -> "missing separator") on Windows checkouts.
Makefile      text eol=lf
*.mk          text eol=lf
*.sh          text eol=lf
*.test        text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.xml         text eol=lf
# SWIFT MT fixtures. The readers strip a trailing CR, but a fixture that reads
# one way on Linux CI and another on a Windows checkout is not a fixture.
*.txt         text eol=lf
*.sta         text eol=lf
# Compressed fixtures are bytes, not text: EOL conversion would corrupt them and
# the gzip magic would survive just long enough to make the failure confusing.
*.gz          binary
# UTF-16 and Latin-1 fixtures are bytes: the encoding is what they test, and an
# EOL or charset rewrite on checkout would change it.
testdata/camt053_utf16.xml binary
testdata/camt053_latin1.xml binary
testdata/mt940_latin1.txt binary
testdata/camt053_undeclared_latin1.xml binary
