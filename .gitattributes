# Makefiles and shell/test scripts must stay LF or the toolchain breaks
# (make -> "missing separator") on Windows checkouts.
Makefile      text eol=lf
*.mk          text eol=lf
*.sh          text eol=lf
*.test        text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.xml         text eol=lf
